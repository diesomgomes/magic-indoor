# Copie para .env e preencha com os dados do seu projeto Supabase (Project Settings → API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Sensivel: da acesso total ao banco, ignorando RLS. So usada pelo backend, nunca pelo navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Gratuita, sem OAuth: crie em https://www.last.fm/api/account/create — usada pela
# integracao "Trilha sonora" (mostra capa/artista/musica tocando agora na programacao).
LASTFM_API_KEY=
